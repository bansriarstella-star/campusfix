# Firebase Web SDK Configuration (Required for Vercel / standalone static deployment)
# Copy this file to .env.local for local overrides, or set these in Vercel Project Settings.
# Note: Never place Firebase Admin SDK credentials, private keys, or service-account JSON here.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

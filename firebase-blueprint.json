{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated CampusFix user profile with non-self-escalating role and hostel details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["student", "provider", "admin"]
        },
        "providerId": {
          "type": "string",
          "maxLength": 128
        },
        "hostelBuilding": {
          "type": "string",
          "maxLength": 100
        },
        "roomNumber": {
          "type": "string",
          "maxLength": 50
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "role",
        "providerId",
        "hostelBuilding",
        "roomNumber",
        "phone",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted administrator marker document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "addedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "addedAt"]
    },
    "ProviderAccount": {
      "title": "ProviderAccount",
      "description": "Trusted mapping between a Firebase Auth UID and an authorized service provider record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "providerId",
        "providerName",
        "email",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProviderPublic": {
      "title": "ProviderPublic",
      "description": "Public safe service provider catalog record without private contact PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["laundry", "repairs", "printing", "housekeeping"]
        },
        "tagline": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "areaServed": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "availableWindows": {
          "type": "array"
        },
        "active": {
          "type": "boolean"
        },
        "isDemoExample": {
          "type": "boolean"
        },
        "ratingAvg": {
          "type": "number"
        },
        "reviewCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "tagline",
        "areaServed",
        "availableWindows",
        "active",
        "isDemoExample",
        "ratingAvg",
        "reviewCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProviderPrivate": {
      "title": "ProviderPrivate",
      "description": "Protected provider contact and account details readable only by admins and the assigned provider.",
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "assignedUid": {
          "type": "string",
          "maxLength": 128
        },
        "accountEmail": {
          "type": "string",
          "maxLength": 150
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 40
        },
        "internalNotes": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "providerId",
        "assignedUid",
        "accountEmail",
        "contactPhone",
        "internalNotes",
        "updatedAt"
      ]
    },
    "ServiceCatalogItem": {
      "title": "ServiceCatalogItem",
      "description": "Campus service offering with demo illustrative pricing and offered booking windows.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["laundry", "repairs", "printing", "housekeeping"]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "priceBasis": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "estimatedMinInr": {
          "type": "number"
        },
        "estimatedMaxInr": {
          "type": "number"
        },
        "turnaroundText": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "availableWindows": {
          "type": "array"
        },
        "active": {
          "type": "boolean"
        },
        "isDemoExample": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "providerId",
        "providerName",
        "category",
        "title",
        "description",
        "priceBasis",
        "estimatedMinInr",
        "estimatedMaxInr",
        "turnaroundText",
        "availableWindows",
        "active",
        "isDemoExample",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingRequest": {
      "title": "BookingRequest",
      "description": "Student service booking request with status lifecycle, snapshots, and location details.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 24,
          "pattern": "^CF-[0-9]{4}-[A-Z0-9]{4,8}$"
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "enum": ["laundry", "repairs", "printing", "housekeeping"]
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "priceBasisSnapshot": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "estimatedMinInr": {
          "type": "number"
        },
        "estimatedMaxInr": {
          "type": "number"
        },
        "scheduledDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeWindow": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60
        },
        "building": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "roomOrPickupPoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instructions": {
          "type": "string",
          "maxLength": 600
        },
        "printingDescription": {
          "type": "string",
          "maxLength": 300
        },
        "printingPageCount": {
          "type": "number"
        },
        "printingColor": {
          "type": "string",
          "enum": ["none", "bw", "color"]
        },
        "status": {
          "type": "string",
          "enum": [
            "Requested",
            "Accepted",
            "In Progress",
            "Completed",
            "Rejected",
            "Cancelled"
          ]
        },
        "statusNote": {
          "type": "string",
          "maxLength": 300
        },
        "cancellationReason": {
          "type": "string",
          "maxLength": 300
        },
        "reviewSubmitted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedAt": {
          "type": "string"
        },
        "inProgressAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "rejectedAt": {
          "type": "string"
        },
        "cancelledAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "referenceCode",
        "studentUid",
        "studentName",
        "studentEmail",
        "category",
        "serviceId",
        "serviceTitle",
        "providerId",
        "providerName",
        "priceBasisSnapshot",
        "estimatedMinInr",
        "estimatedMaxInr",
        "scheduledDate",
        "timeWindow",
        "building",
        "roomOrPickupPoint",
        "instructions",
        "printingDescription",
        "printingPageCount",
        "printingColor",
        "status",
        "statusNote",
        "cancellationReason",
        "reviewSubmitted",
        "createdAt",
        "updatedAt",
        "acceptedAt",
        "inProgressAt",
        "completedAt",
        "rejectedAt",
        "cancelledAt"
      ]
    },
    "ServiceReview": {
      "title": "ServiceReview",
      "description": "One-time post-completion student review keyed by bookingId to prevent duplicate reviews.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "bookingId",
        "studentUid",
        "studentName",
        "providerId",
        "serviceId",
        "rating",
        "comment",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Signed-in student, provider, and admin profile documents."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted administrator access marker documents."
    },
    "/providerAccounts/{userId}": {
      "schema": { "$ref": "#/entities/ProviderAccount" },
      "description": "Trusted mapping between Firebase Auth UID and assigned providerId."
    },
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/ProviderPublic" },
      "description": "Public safe service provider catalog entries."
    },
    "/providerPrivate/{providerId}": {
      "schema": { "$ref": "#/entities/ProviderPrivate" },
      "description": "Protected provider contact and account details."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceCatalogItem" },
      "description": "Public service catalog offerings linked to providers."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingRequest" },
      "description": "Student service booking requests and status history."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ServiceReview" },
      "description": "Completed-booking reviews keyed by bookingId (max 1 per booking)."
    }
  }
}
